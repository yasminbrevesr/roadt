---
/**
 * Botão de ação (sempre um link real — nunca um botão sem destino).
 * Somente texto: o site não usa setas nem ícones decorativos nos botões.
 */
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'outline' | 'outline-light' | 'dark' | 'light';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  href: string;
  variant?: Variant;
  size?: 'md' | 'lg';
  /** Abre em nova aba (links de terceiros, como WhatsApp e Instagram). */
  external?: boolean;
  block?: boolean;
}

const { href, variant = 'primary', size = 'md', external = false, block = false, class: className, ...rest } =
  Astro.props;

const externalProps = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, { 'btn--block': block }, className]}
  {...externalProps}
  {...rest}
>
  <span class="btn__label"><slot /></span>
  {external && <span class="visually-hidden"> (abre em nova aba)</span>}
</a>

<style>
  .btn {
    --btn-bg: var(--c-sun);
    --btn-fg: var(--c-ink);
    --btn-border: transparent;
    --btn-bg-hover: #ff7a4a;
    --btn-fg-hover: var(--c-ink);

    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.75rem 1.5rem;
    border: 1.5px solid var(--btn-border);
    border-radius: var(--radius-pill);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.15;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }

  .btn--lg {
    min-height: 3.5rem;
    padding: 0.9rem 1.9rem;
    font-size: 1rem;
  }

  .btn--block {
    display: flex;
    width: 100%;
  }

  .btn:hover {
    background: var(--btn-bg-hover);
    color: var(--btn-fg-hover);
  }

  .btn:active {
    transform: scale(0.98);
  }

  .btn--outline {
    --btn-bg: transparent;
    --btn-fg: var(--c-ink);
    --btn-border: var(--c-ink);
    --btn-bg-hover: var(--c-ink);
    --btn-fg-hover: var(--c-paper);
  }

  .btn--outline-light {
    --btn-bg: transparent;
    --btn-fg: var(--c-paper);
    --btn-border: rgb(246 241 231 / 0.75);
    --btn-bg-hover: var(--c-paper);
    --btn-fg-hover: var(--c-ink);
  }

  .btn--dark {
    --btn-bg: var(--c-ink);
    --btn-fg: var(--c-paper);
    --btn-bg-hover: var(--c-lagoon);
    --btn-fg-hover: var(--c-paper);
  }

  .btn--light {
    --btn-bg: var(--c-paper);
    --btn-fg: var(--c-ink);
    --btn-bg-hover: #fff;
    --btn-fg-hover: var(--c-ink);
  }
</style>
