---
/**
 * Logo da RoadTrip021.
 *
 * PENDENTE: o arquivo oficial do logo não está no repositório. Salve-o em
 * src/assets/brand/logo.svg (ou .png/.webp) e ele substitui automaticamente
 * o logotipo tipográfico provisório abaixo.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '@/config/site';

interface Props {
  class?: string;
  /** Altura do logo em pixels quando houver arquivo oficial. */
  height?: number;
}

const { class: className, height = 36 } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/brand/logo.{svg,png,webp}', { eager: true });
const logo = Object.values(files)[0]?.default;
---

{
  logo ? (
    <Image src={logo} alt={site.name} height={height} class:list={['logo-img', className]} loading="eager" />
  ) : (
    <span class:list={['logo', className]} data-logo-pending>
      <span class="logo__word">RoadTrip</span>
      <span class="logo__code">021</span>
    </span>
  )
}

<style>
  .logo {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.2rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }

  .logo__code {
    display: inline-block;
    padding: 0.18em 0.32em 0.14em;
    border-radius: 0.35em;
    background: var(--c-sun);
    color: var(--c-ink);
    font-size: 0.55em;
    letter-spacing: 0;
    transform: rotate(-6deg) translateY(-0.1em);
  }

  .logo-img {
    width: auto;
  }
</style>
