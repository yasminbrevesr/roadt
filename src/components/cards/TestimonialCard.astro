---
/**
 * Card de avaliação. Use somente com avaliações reais (ver src/data/reviews.ts).
 */
import type { Review } from '@/data/reviews';

interface Props {
  review: Review;
}

const { review } = Astro.props;
const rating = Math.max(0, Math.min(5, Math.round(review.rating)));
---

<figure class="tst">
  <p class="tst__rating">
    <span class="visually-hidden">Nota </span><strong>{rating}</strong>/5
  </p>
  <blockquote class="tst__text">
    <p>{review.text}</p>
  </blockquote>
  <figcaption class="tst__author">
    <span class="tst__avatar" aria-hidden="true">{review.author.trim().charAt(0).toUpperCase()}</span>
    <span>
      <strong>{review.author}</strong>
      {(review.trip || review.date) && <span class="tst__meta">{[review.trip, review.date].filter(Boolean).join(' · ')}</span>}
    </span>
  </figcaption>
</figure>

<style>
  .tst {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1.1rem;
    height: 100%;
    padding: 1.6rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background: #fffdf8;
  }

  .tst__rating {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-muted);
  }

  .tst__rating strong {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--c-sun-deep);
  }

  .tst__text {
    font-size: var(--fs-lg);
    line-height: 1.5;
  }

  .tst__author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--fs-sm);
    line-height: 1.3;
  }

  .tst__author > span:last-child {
    display: grid;
  }

  .tst__meta {
    color: var(--c-muted);
  }

  .tst__avatar {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--c-lagoon);
    color: var(--c-paper);
    font-family: var(--font-display);
    font-weight: 700;
  }
</style>
