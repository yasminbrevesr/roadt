---
/**
 * Cabeçalho fixo no topo, com fundo sólido (ganha uma sombra leve ao rolar).
 * No mobile, o menu abre em um <dialog> nativo: prende o foco, fecha com ESC
 * e bloqueia a interação com o restante da página.
 */
import Logo from '@/components/ui/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import CTAButton from '@/components/ui/CTAButton.astro';
import { mainNav } from '@/data/navigation';
import { site } from '@/config/site';
import { tripsPage, whatsappLink, withBase } from '@/lib/links';

const allTrips = tripsPage();
const home = withBase('/');
---

<header class="site-header" data-header>
  <div class="site-header__inner container">
    <a href={home} class="site-header__brand" aria-label={`${site.name} — página inicial`}>
      <Logo />
    </a>

    <nav class="site-header__nav" aria-label="Principal">
      <ul>
        {
          mainNav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <CTAButton href={allTrips} class="site-header__cta">Encontrar viagens</CTAButton>
      <button
        type="button"
        class="site-header__toggle"
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-open
      >
        <Icon name="menu" size={24} />
        <span class="visually-hidden">Abrir menu</span>
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-menu" class="mmenu on-dark" aria-label="Menu" data-menu>
  <div class="mmenu__top container">
    <a href={home} class="site-header__brand" aria-label={`${site.name} — página inicial`} data-menu-link>
      <Logo />
    </a>
    <button type="button" class="mmenu__close" data-menu-close>
      <Icon name="close" size={24} />
      <span class="visually-hidden">Fechar menu</span>
    </button>
  </div>

  <nav class="mmenu__nav container" aria-label="Principal (mobile)">
    <ol>
      {
        mainNav.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={item.href} data-menu-link>
              <span class="mmenu__num">{String(i + 1).padStart(2, '0')}</span>
              {item.label}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="mmenu__bottom container">
    <CTAButton href={allTrips} size="lg" block>Encontrar viagens</CTAButton>
    <CTAButton href={whatsappLink()} variant="outline-light" size="lg" block external>
      Falar no WhatsApp
    </CTAButton>
    <a class="mmenu__social" href={site.instagram.url} target="_blank" rel="noopener noreferrer">
      Instagram @{site.instagram.handle}
      <span class="visually-hidden"> (abre em nova aba)</span>
    </a>
  </div>
</dialog>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = menu?.querySelector<HTMLButtonElement>('[data-menu-close]');

  // Estado "rolado": sombra leve quando a página sai do topo.
  if (header) {
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:24px;pointer-events:none;';
    document.body.prepend(sentinel);
    new IntersectionObserver(([entry]) => {
      header.classList.toggle('is-scrolled', !entry?.isIntersecting);
    }).observe(sentinel);
  }

  // Menu mobile
  if (menu && openBtn) {
    const setExpanded = (value: boolean) => openBtn.setAttribute('aria-expanded', String(value));

    openBtn.addEventListener('click', () => {
      menu.showModal();
      document.documentElement.classList.add('menu-open');
      setExpanded(true);
    });

    const close = () => menu.close();
    closeBtn?.addEventListener('click', close);

    // Fecha ao escolher um link (âncoras da mesma página).
    menu.querySelectorAll('[data-menu-link]').forEach((link) => link.addEventListener('click', close));

    // Clique fora do conteúdo (no backdrop) também fecha.
    menu.addEventListener('click', (event) => {
      if (event.target === menu) close();
    });

    menu.addEventListener('close', () => {
      document.documentElement.classList.remove('menu-open');
      setExpanded(false);
      openBtn.focus();
    });

    // Se a tela crescer para desktop com o menu aberto, fecha.
    window.matchMedia('(min-width: 64rem)').addEventListener('change', (mq) => {
      if (mq.matches && menu.open) close();
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    color: var(--c-ink);
    background: var(--c-paper);
    border-bottom: 1px solid var(--c-line);
    transition: box-shadow var(--dur) var(--ease-out);
  }

  .site-header.is-scrolled {
    box-shadow: 0 8px 24px -16px rgb(15 31 26 / 0.45);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 100%;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    text-decoration: none;
  }

  .site-header__brand :global(.logo-img) {
    height: 52px;
    width: auto;
  }

  @media (min-width: 64rem) {
    .site-header__brand :global(.logo-img) {
      height: 62px;
    }
  }

  .site-header__nav {
    display: none;
  }

  .site-header__nav ul {
    display: flex;
    gap: 0.25rem;
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.85rem;
    font-weight: 800;
    font-size: 0.875rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .site-header__nav a::after {
    content: '';
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 0.45rem;
    border-top: 2px solid var(--c-sun);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease-out);
  }

  .site-header__nav a:hover::after {
    transform: scaleX(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .site-header__actions :global(.site-header__cta) {
    display: none;
  }

  .site-header__toggle {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-right: -0.5rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
  }

  @media (min-width: 64rem) {
    .site-header__nav {
      display: block;
    }

    .site-header__actions :global(.site-header__cta) {
      display: inline-flex;
    }

    .site-header__toggle {
      display: none;
    }
  }

  /* ---------- Menu mobile ---------- */
  .mmenu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--c-ink);
    color: var(--c-paper);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mmenu[open] {
    display: flex;
    flex-direction: column;
  }

  .mmenu::backdrop {
    background: rgb(15 31 26 / 0.6);
  }

  .mmenu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    flex: none;
  }

  .mmenu__close {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-right: -0.5rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
  }

  .mmenu__nav {
    flex: 1;
    display: flex;
    align-items: center;
    padding-block: 1.5rem;
  }

  .mmenu__nav ol {
    display: grid;
    gap: 0.25rem;
    width: 100%;
    padding: 0;
    list-style: none;
  }

  .mmenu__nav a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--c-line-dark);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 4vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .mmenu__num {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--c-sun);
  }

  .mmenu__bottom {
    display: grid;
    gap: 0.75rem;
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
  }

  .mmenu__social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    font-weight: 600;
    color: var(--c-muted-dark);
    text-decoration: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mmenu[open] .mmenu__nav li {
      animation: mmenu-in var(--dur-slow) var(--ease-out) both;
      animation-delay: calc(var(--i) * 50ms + 60ms);
    }

    @keyframes mmenu-in {
      from {
        opacity: 0;
        transform: translateY(0.75rem);
      }
    }
  }

  :global(html.menu-open) {
    overflow: hidden;
  }
</style>
