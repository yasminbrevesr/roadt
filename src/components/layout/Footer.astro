---
/**
 * Rodapé: chamada final, marca, navegação, atendimento e informações legais.
 * Somente texto (sem ícones). Dados legais aparecem quando preenchidos em src/config/site.ts.
 */
import Logo from '@/components/ui/Logo.astro';
import { legalLinks, mainNav, tripShortcuts } from '@/data/navigation';
import { site } from '@/config/site';
import { whatsappLink, withBase } from '@/lib/links';

const year = new Date().getFullYear();
const { companyName, cnpj, address } = site.legal;
const hasLegal = Boolean(companyName || cnpj || address);
---

<footer class="site-footer on-dark" aria-labelledby="footer-title">
  <h2 id="footer-title" class="visually-hidden">Rodapé</h2>

  <div class="container">
    <div class="sf-cta">
      <p class="sf-cta__title">{site.tagline}</p>
    </div>

    <div class="sf-grid">
      <div class="sf-brand">
        <a href={withBase('/')} class="sf-brand__logo" aria-label={`${site.name} — página inicial`}>
          <Logo />
        </a>
        <p class="sf-brand__text">{site.mission}</p>
        <p class="sf-brand__meta">{site.homeBase} · desde {site.since.year}</p>
      </div>

      <nav class="sf-col" aria-labelledby="sf-nav">
        <h3 id="sf-nav" class="sf-col__title">Navegação</h3>
        <ul>
          {
            mainNav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="sf-col" aria-labelledby="sf-trips">
        <h3 id="sf-trips" class="sf-col__title">Viagens</h3>
        <ul>
          {
            tripShortcuts.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="sf-col sf-contact">
        <h3 class="sf-col__title">Atendimento</h3>
        <dl>
          <div>
            <dt>WhatsApp oficial</dt>
            <dd>
              <a href={whatsappLink()} target="_blank" rel="noopener noreferrer">
                {site.whatsapp.display}
                <span class="visually-hidden"> (abre em nova aba)</span>
              </a>
            </dd>
          </div>
          <div>
            <dt>Instagram</dt>
            <dd>
              <a href={site.instagram.url} target="_blank" rel="noopener noreferrer">
                @{site.instagram.handle}
                <span class="visually-hidden"> (abre em nova aba)</span>
              </a>
            </dd>
          </div>
        </dl>
        <p class="sf-contact__note">Dúvidas e solicitações são atendidas somente pelo canal oficial.</p>
      </div>
    </div>
  </div>

  {/* Marca decorativa desenhada via CSS (::before), fora da leitura de tela. */}
  <div class="sf-wordmark" aria-hidden="true"></div>

  <div class="container sf-bottom">
    <div class="sf-bottom__info">
      <p>© {year} {site.name}. Todos os direitos reservados.</p>
      {hasLegal && <p>{[companyName, cnpj && `CNPJ ${cnpj}`, address].filter(Boolean).join(' · ')}</p>}
    </div>
    <ul class="sf-bottom__links">
      {
        legalLinks.map((item) =>
          item.external ? (
            <li>
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                {item.label}
                <span class="visually-hidden"> (abre em nova aba)</span>
              </a>
            </li>
          ) : (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ),
        )
      }
      <li>
        <a href="#conteudo">Voltar ao topo</a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    overflow: hidden;
    padding-top: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    background: var(--c-ink);
    color: var(--c-paper);
  }

  .site-footer a:not(.btn) {
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .site-footer a:not(.btn):hover {
    color: var(--c-sun);
  }

  /* ---------- Chamada ---------- */
  .sf-cta {
    display: grid;
    gap: 1.5rem;
    padding-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    border-bottom: 1px solid var(--c-line-dark);
  }

  .sf-cta__title {
    max-width: 20ch;
    color: var(--c-sun);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  /* ---------- Colunas ---------- */
  .sf-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.5rem;
    padding-block: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .sf-brand,
  .sf-contact {
    grid-column: 1 / -1;
  }

  @media (min-width: 64rem) {
    .sf-grid {
      grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr));
      gap: 2rem 3rem;
    }

    .sf-brand,
    .sf-contact {
      grid-column: auto;
    }
  }

  .sf-brand {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .sf-brand__logo {
    display: inline-flex;
    justify-self: start;
    align-items: center;
    min-height: 3rem;
  }

  .sf-brand__logo :global(.logo) {
    font-size: 1.875rem;
  }

  .sf-brand__text {
    max-width: 30rem;
    color: var(--c-muted-dark);
  }

  .sf-brand__meta {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .sf-col__title {
    margin-bottom: 0.75rem;
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-sun);
  }

  .sf-col ul {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .sf-col li a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
  }

  .sf-contact dl {
    display: grid;
    gap: 1rem;
  }

  .sf-contact dt {
    font-size: var(--fs-sm);
    color: var(--c-muted-dark);
  }

  .sf-contact dd a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .sf-contact__note {
    margin-top: 1rem;
    max-width: 22rem;
    font-size: var(--fs-sm);
    color: var(--c-muted-dark);
  }

  /* ---------- Marca em destaque ---------- */
  .sf-wordmark::before {
    content: 'RoadTrip021';
  }

  .sf-wordmark {
    margin: 0;
    font-family: var(--font-display);
    font-size: 16.5vw;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    text-align: center;
    white-space: nowrap;
    color: var(--c-ink-2);
    user-select: none;
  }

  /* ---------- Barra inferior ---------- */
  .sf-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--c-line-dark);
    font-size: var(--fs-sm);
    color: var(--c-muted-dark);
  }

  .sf-bottom__info {
    display: grid;
    gap: 0.25rem;
  }

  .sf-bottom__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .sf-bottom__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--c-paper);
  }
</style>
