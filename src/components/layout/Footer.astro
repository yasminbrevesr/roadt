---
import Logo from '@/components/ui/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import { legalLinks, mainNav, storeShortcuts } from '@/data/navigation';
import { site } from '@/config/site';
import { whatsappLink } from '@/lib/links';

const year = new Date().getFullYear();
const { companyName, cnpj, address } = site.legal;
---

<footer class="site-footer on-dark" aria-labelledby="footer-title">
  <h2 id="footer-title" class="visually-hidden">Rodapé</h2>
  <div class="container">
    <div class="site-footer__top">
      <a href="/" class="site-footer__brand" aria-label={`${site.name} — página inicial`}>
        <Logo />
      </a>
      <p class="site-footer__tagline">{site.tagline}</p>
      <p class="site-footer__mission">{site.mission}</p>
    </div>

    <div class="site-footer__cols">
      <nav aria-labelledby="footer-nav">
        <h3 id="footer-nav" class="site-footer__heading">Navegação</h3>
        <ul>
          {
            mainNav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-trips">
        <h3 id="footer-trips" class="site-footer__heading">Viagens</h3>
        <ul>
          {
            storeShortcuts.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h3 class="site-footer__heading">Fale com a gente</h3>
        <ul>
          <li>
            <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="site-footer__contact">
              <Icon name="whatsapp" size={18} />
              <span>
                WhatsApp {site.whatsapp.display}
                <span class="site-footer__hint">canal oficial de atendimento</span>
              </span>
              <span class="visually-hidden"> (abre em nova aba)</span>
            </a>
          </li>
          <li>
            <a href={site.instagram.url} target="_blank" rel="noopener noreferrer" class="site-footer__contact">
              <Icon name="instagram" size={18} />
              <span>@{site.instagram.handle}</span>
              <span class="visually-hidden"> (abre em nova aba)</span>
            </a>
          </li>
        </ul>
      </div>

      <nav aria-labelledby="footer-legal">
        <h3 id="footer-legal" class="site-footer__heading">Institucional</h3>
        <ul>
          {
            legalLinks.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p>
        © {year} {site.name}. Todos os direitos reservados.
      </p>
      {
        (companyName || cnpj || address) && (
          <p class="site-footer__legal">{[companyName, cnpj && `CNPJ ${cnpj}`, address].filter(Boolean).join(' · ')}</p>
        )
      }
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem) 2rem;
    background: var(--c-ink);
    color: var(--c-paper);
  }

  .site-footer__top {
    display: grid;
    gap: 1rem;
    padding-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    border-bottom: 1px solid var(--c-line-dark);
  }

  .site-footer__brand {
    display: inline-flex;
    justify-self: start;
    min-height: 3rem;
    align-items: center;
    text-decoration: none;
  }

  .site-footer__brand :global(.logo) {
    font-size: 2rem;
  }

  .site-footer__tagline {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--c-sun);
  }

  .site-footer__mission {
    max-width: 36rem;
    color: var(--c-muted-dark);
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    gap: 2.25rem 2rem;
    padding-block: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .site-footer__heading {
    margin-bottom: 0.9rem;
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-muted-dark);
  }

  .site-footer ul {
    display: grid;
    gap: 0.15rem;
    padding: 0;
    list-style: none;
  }

  .site-footer__cols a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .site-footer__cols a:hover {
    color: var(--c-sun);
  }

  .site-footer__contact {
    gap: 0.6rem;
  }

  .site-footer__contact > span:not(.visually-hidden) {
    display: grid;
    line-height: 1.3;
  }

  .site-footer__hint {
    font-size: var(--fs-xs);
    color: var(--c-muted-dark);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--c-line-dark);
    font-size: var(--fs-sm);
    color: var(--c-muted-dark);
  }
</style>
