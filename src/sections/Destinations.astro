---
import SectionTitle from '@/components/ui/SectionTitle.astro';
import TravelCard from '@/components/cards/TravelCard.astro';
import { destinations } from '@/data/destinations';
import type { Departure } from '@/data/departures';
import { storeShortcuts } from '@/data/navigation';
import { storeSearchLink } from '@/lib/links';

interface Props {
  index?: string;
  upcoming: Departure[];
}

const { index, upcoming } = Astro.props;
const nextFor = (slug: string) => upcoming.find((d) => d.destination === slug);
---

<section id="viagens" class="section destinations" aria-labelledby="viagens-title">
  <div class="container">
    <div class="destinations__head">
      <SectionTitle
        id="viagens-title"
        index={index}
        eyebrow="Destinos"
        title="Descubra nossas <em>viagens</em>"
        singleLineEm={13.4}
        lead="Trilhas, praias, desertos e expedições pelo Brasil e pela América do Sul. Escolha o destino e veja as saídas disponíveis."
      />
      <div class="filters" role="group" aria-label="Filtrar destinos" data-filters hidden>
        <button type="button" class="filters__btn" aria-pressed="true" data-filter="all">Todos</button>
        <button type="button" class="filters__btn" aria-pressed="false" data-filter="brasil">Brasil</button>
        <button type="button" class="filters__btn" aria-pressed="false" data-filter="internacional">
          América do Sul
        </button>
      </div>
    </div>

    <ul class="dest-grid" data-dest-grid>
      {
        destinations.map((d, i) => (
          <li
            class:list={['dest-grid__item', { 'is-wide': d.featured }]}
            data-scope={d.scope}
            data-reveal
            style={`--reveal-delay:${(i % 4) * 70}ms`}
          >
            <TravelCard
              destination={d}
              wide={d.featured}
              href={storeSearchLink(d.searchTerm)}
              nextDeparture={nextFor(d.slug)}
            />
          </li>
        ))
      }
    </ul>
    <p class="visually-hidden" aria-live="polite" data-filter-status></p>

    <div class="destinations__more" data-reveal>
      <p class="destinations__more-label">Explore por</p>
      <ul class="chips">
        {
          storeShortcuts.map((item) => (
            <li>
              <a class="chip" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  const grid = document.querySelector<HTMLElement>('[data-dest-grid]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');

  if (filters && grid) {
    filters.hidden = false; // os filtros só aparecem quando o JavaScript está ativo
    const buttons = filters.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = grid.querySelectorAll<HTMLElement>('[data-scope]');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter ?? 'all';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        let visible = 0;
        items.forEach((item) => {
          const show = filter === 'all' || item.dataset.scope === filter;
          item.hidden = !show;
          if (show) {
            visible += 1;
            item.classList.add('is-visible');
          }
        });
        grid.scrollTo({ left: 0 });
        if (status) status.textContent = `${visible} destinos exibidos`;
      });
    });
  }
</script>

<style>
  .destinations__head {
    display: grid;
    gap: 0 2rem;
  }

  /* Filtros logo abaixo do texto de apoio (o título usa a largura toda). */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: calc(1.25rem - clamp(2.25rem, 1.5rem + 3vw, 4rem)) 0 clamp(1.75rem, 1.25rem + 2vw, 3rem);
  }

  .filters__btn {
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem;
    border: 1.5px solid var(--c-line);
    border-radius: var(--radius-pill);
    background: transparent;
    font-weight: 600;
    font-size: var(--fs-sm);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .filters__btn:hover {
    border-color: var(--c-ink);
  }

  .filters__btn[aria-pressed='true'] {
    background: var(--c-ink);
    border-color: var(--c-ink);
    color: var(--c-paper);
  }

  /* Mobile: carrossel com rolagem lateral e encaixe por card */
  .dest-grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(80%, 20rem);
    gap: 0.875rem;
    margin: 0 calc(var(--gutter) * -1);
    padding: 0.5rem var(--gutter) 1rem;
    scroll-padding-inline: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    list-style: none;
  }

  .dest-grid::-webkit-scrollbar {
    display: none;
  }

  .dest-grid__item {
    scroll-snap-align: start;
  }

  @media (min-width: 37.5rem) {
    .dest-grid {
      grid-auto-flow: row dense;
      grid-auto-columns: auto;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      margin: 0;
      padding: 0;
      overflow: visible;
      scroll-snap-type: none;
    }

    .dest-grid__item.is-wide {
      grid-column: span 2;
    }
  }

  @media (min-width: 45rem) {
    .dest-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 56rem) {
    .dest-grid {
      gap: 1.25rem;
    }
  }

  @media (min-width: 75rem) {
    .dest-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .destinations__more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--c-line);
  }

  .destinations__more-label {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    background: var(--c-sand);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .chip:hover {
    background: var(--c-ink);
    color: var(--c-paper);
  }
</style>
