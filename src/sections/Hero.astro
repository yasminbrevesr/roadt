---
/**
 * Topo da página: chamada principal à esquerda e foto (ou carrossel) à direita, em uma
 * moldura no tamanho em que as fotos atuais ficam nítidas (sem esticar a imagem).
 * - Usa só as fotos que já existem em src/assets/photos. Com uma foto, ela fica fixa;
 *   com duas ou mais, vira carrossel. Sem nenhuma, mostra um espaço reservado.
 * - As fotos trocam sozinhas (com transição suave) e podem ser escolhidas pelos indicadores.
 * - Pausa ao passar o mouse, ao navegar por teclado dentro dele, com a aba em segundo
 *   plano e pelo botão "Pausar". Quem prefere menos movimento começa com ele pausado.
 * - No celular, dá para deslizar o dedo para trocar de foto.
 * - Só a primeira foto carrega com prioridade; as demais carregam depois da página.
 */
import Photo from '@/components/ui/Photo.astro';
import CTAButton from '@/components/ui/CTAButton.astro';
import { heroSlides as allSlides, HERO_INTERVAL_MS } from '@/data/hero';
import { hasPhoto } from '@/lib/photos';

const available = allSlides.filter((slide) => hasPhoto(slide.photo));
const heroSlides = available.length > 0 ? available : allSlides.slice(0, 1);
const total = heroSlides.length;
const pad = (n: number) => String(n).padStart(2, '0');
const tones = ['ink', 'lagoon', 'clay'] as const;
---

<section
  class="hero on-dark"
  aria-roledescription="carrossel"
  aria-label="Fotos de viagens da RoadTrip021"
  data-hero
  data-interval={HERO_INTERVAL_MS}
  style={`--hero-interval:${HERO_INTERVAL_MS}ms`}
>
  <div class="container hero__grid">
    <div class="hero__content">
      <h1 class="hero__title">Sua próxima <em>história</em> começa aqui.</h1>
      <p class="hero__lead">
        Conheça lugares incríveis, faça novas amizades e viva experiências que vão muito além de uma viagem.
      </p>
      <div class="hero__actions">
        <CTAButton href="#viagens" size="lg">Explorar viagens</CTAButton>
      </div>

      {
        total > 1 && (
          <div class="hero__controls" data-hero-controls hidden>
            <div class="hero__dots" role="group" aria-label="Escolher foto">
              {heroSlides.map((_, i) => (
                <button
                  type="button"
                  class="hero__dot"
                  aria-label={`Mostrar foto ${i + 1} de ${total}`}
                  aria-current={i === 0 ? 'true' : undefined}
                  data-go={i}
                >
                  <span class="hero__dot-bar">
                    <span class="hero__dot-fill" />
                  </span>
                </button>
              ))}
            </div>
            <p class="hero__count" aria-hidden="true">
              <span data-hero-current>01</span> / {pad(total)}
            </p>
            <button type="button" class="hero__pause" aria-pressed="false" data-hero-pause>
              Pausar
            </button>
          </div>
        )
      }
    </div>
    <div class="hero__frame">
      <div class="hero__slides" aria-live="off">
        {
          heroSlides.map((slide, i) => (
            <figure
              class:list={['hero__slide', { 'is-active': i === 0, 'is-dormant': i > 0 }]}
              data-slide={i}
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} de ${total}`}
              aria-hidden={i === 0 ? 'false' : 'true'}
            >
              <Photo
                name={slide.photo}
                alt={slide.alt}
                priority={i === 0}
                sizes="(min-width: 64rem) 46vw, 92vw"
                widths={[480, 720, 960, 1350]}
                tone={tones[i % tones.length]}
                pending="compact-mobile"
                position={slide.position}
              />
              {slide.caption && <figcaption class="hero__caption">{slide.caption}</figcaption>}
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  function initHero(root: HTMLElement) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const controls = root.querySelector<HTMLElement>('[data-hero-controls]');
    if (slides.length < 2 || !controls) return;

    const dots = Array.from(controls.querySelectorAll<HTMLButtonElement>('[data-go]'));
    const pauseBtn = controls.querySelector<HTMLButtonElement>('[data-hero-pause]');
    const counter = controls.querySelector<HTMLElement>('[data-hero-current]');
    const interval = Number(root.dataset.interval) || 6000;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const holds = new Set<string>(); // motivos de pausa temporária (mouse, foco, aba oculta)
    let userPaused = reduceMotion;
    let index = 0;
    let timer: number | undefined;

    const running = () => !userPaused && holds.size === 0;

    function schedule() {
      window.clearTimeout(timer);
      root.classList.remove('is-ticking');
      void root.offsetWidth; // reinicia a animação da barra de progresso
      if (running()) {
        root.classList.add('is-ticking');
        timer = window.setTimeout(() => show(index + 1), interval);
      }
    }

    function show(next: number) {
      const target = (next + slides.length) % slides.length;
      if (target !== index) {
        slides[index]?.classList.remove('is-active');
        slides[index]?.setAttribute('aria-hidden', 'true');
        index = target;
        slides[index]?.classList.add('is-active');
        slides[index]?.setAttribute('aria-hidden', 'false');
        dots.forEach((dot, i) => {
          if (i === index) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
        if (counter) counter.textContent = String(index + 1).padStart(2, '0');
      }
      schedule();
    }

    function hold(reason: string, active: boolean) {
      if (active) holds.add(reason);
      else holds.delete(reason);
      schedule();
    }

    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));

    pauseBtn?.addEventListener('click', () => {
      userPaused = !userPaused;
      pauseBtn.setAttribute('aria-pressed', String(userPaused));
      pauseBtn.textContent = userPaused ? 'Continuar' : 'Pausar';
      schedule();
    });
    if (pauseBtn && userPaused) {
      pauseBtn.setAttribute('aria-pressed', 'true');
      pauseBtn.textContent = 'Continuar';
    }

    if (window.matchMedia('(hover: hover)').matches) {
      root.addEventListener('mouseenter', () => hold('hover', true));
      root.addEventListener('mouseleave', () => hold('hover', false));
    }
    root.addEventListener('focusin', () => hold('focus', true));
    root.addEventListener('focusout', (event) => {
      if (!root.contains(event.relatedTarget as Node | null)) hold('focus', false);
    });
    document.addEventListener('visibilitychange', () => hold('hidden', document.hidden));

    // Deslizar o dedo (celular/tablet)
    let startX = 0;
    let startY = 0;
    root.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse') return;
      startX = event.clientX;
      startY = event.clientY;
    });
    root.addEventListener('pointerup', (event) => {
      if (event.pointerType === 'mouse') return;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1));
    });

    // As demais fotos só começam a carregar depois da página pronta (não atrasa a primeira).
    const activate = () => {
      slides.forEach((slide) => slide.classList.remove('is-dormant'));
      controls.hidden = false;
      schedule();
    };
    if (document.readyState === 'complete') activate();
    else window.addEventListener('load', activate, { once: true });
  }

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) initHero(hero);
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5.5rem);
    background: var(--c-ink);
    color: var(--c-paper);
    touch-action: pan-y;
  }

  .hero__grid {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }
  }

  /* ---------- Texto ---------- */
  .hero__content {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .hero__title {
    max-width: 12ch;
    font-size: clamp(2.75rem, 1.4rem + 4.2vw, 5.5rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .hero__title em {
    font-style: normal;
    color: var(--c-sun);
  }

  .hero__lead {
    max-width: 34rem;
    font-size: var(--fs-lg);
    line-height: 1.55;
    color: rgb(246 241 231 / 0.88);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  /* ---------- Foto ---------- */
  .hero__frame {
    position: relative;
    width: 100%;
    max-width: 42rem;
    justify-self: center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
  }

  @media (min-width: 64rem) {
    .hero__frame {
      justify-self: end;
    }
  }

  .hero__slides {
    position: absolute;
    inset: 0;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    overflow: hidden;
    transition: opacity 1.2s var(--ease-out);
    --pending-top: 1rem;
    --pending-right: 1rem;
  }

  .hero__slide.is-active {
    opacity: 1;
  }

  .hero__slide.is-dormant {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide {
      transition: none;
    }
  }

  .hero__caption {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    background: rgb(15 31 26 / 0.6);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-paper);
  }

  /* ---------- Controles (só com 2 ou mais fotos) ---------- */
  .hero__controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 30rem;
    margin-top: 1rem;
  }

  .hero__dots {
    display: flex;
    flex: 1;
    gap: 0.4rem;
  }

  .hero__dot {
    flex: 1;
    min-width: 1.5rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .hero__dot-bar {
    position: relative;
    display: block;
    height: 3px;
    overflow: hidden;
    border-radius: 3px;
    background: rgb(246 241 231 / 0.35);
  }

  .hero__dot-fill {
    position: absolute;
    inset: 0;
    background: var(--c-paper);
    transform: scaleX(0);
    transform-origin: left;
  }

  .hero__dot[aria-current='true'] .hero__dot-fill {
    transform: scaleX(1);
  }

  .hero.is-ticking .hero__dot[aria-current='true'] .hero__dot-fill {
    animation: hero-fill var(--hero-interval) linear both;
  }

  @keyframes hero-fill {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  .hero__count {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
    color: rgb(246 241 231 / 0.85);
  }

  .hero__pause {
    min-height: 2.75rem;
    padding: 0 0.25rem;
    border: 0;
    background: transparent;
    color: var(--c-paper);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: rgb(246 241 231 / 0.4);
    text-underline-offset: 0.3em;
  }
</style>
